setenv FIREDIR /tmp/FIRE
setenv LD_LIBRARY_PATH /tmp/FIRE/modules/lib
cd /tmp
date
echo "DNA, remove duplicates, create /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt"
perl /tmp/FIRE/SCRIPTS/remove_homologous_sequences_withseed.pl -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt -quantized 1 -fastafile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/seqs.fa -outfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt
echo "DNA, Step 1: seed discovery."
/tmp/FIRE/PROGRAMS/mi_find -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt -quantized 1 -fastafile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/seqs.fa -outfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.seeds -report 1 -docor 1 -outprm 1 -shuffle -1 -jn 0 -jn_t 0 -verbose 1 -rna 0
echo "DNA, Step 2: seed optimization."
/tmp/FIRE/PROGRAMS/mi_optimize -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt -quantized 1 -fastafile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/seqs.fa -outfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.optim -kmerfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.seeds -shuffle 10000 -report 0 -log 1 -rna 0 -verbose 0 -mask 0 -minr 2 -maxfreq 0.33 -add 1 
echo "DNA, Step 3: evaluation of motif significances."
/tmp/FIRE/PROGRAMS/mi_signif -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt -quantized 1 -fastafile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/seqs.fa -motiffile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.optim -shuffle 10000 -optimout 1 -outfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.signif -rna 0 -jn 10 -jn_t 0 -jn_f 3 
echo "DNA, Step 3.5: creating binary expression profiles."
perl /tmp/FIRE/SCRIPTS/mi_create_overep_expfile.pl -repfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.signif.motifs.rep -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt -quantized 1 -outexpfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.binary
echo "DNA, Step 4: discovery of distance constraints."
/tmp/FIRE/PROGRAMS/mi_dist -expfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt -expfile_b /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.binary -quantized 1 -fastafile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/seqs.fa -motiffile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.optim -shuffle 10000 -outfile /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.dist -mbins_interval 150 -rna 0 -donbcopies 1
echo "DNA, Step 5: summarize information."
perl /tmp/FIRE/SCRIPTS/mi_summarize.pl  -optimfile_dna /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.optim -statfile_dna /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.signif -distfile_dna /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.dist  -quantized 1 -outmatrix /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.matrix -outfullmatrix /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.fullmatrix -outdensitymatrix /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.densities -outcolumns /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.columns -outgoodcolumns /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.signifcolumns -outnames /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.motifnames -outsummary /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.summary -removecols_exp 0 -minrobustness 6 -outlevel 2 -maxrobustness 10  -removecols_draw 0  -oribiasonly 1  -expfile_b_dna /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.binary  -outexpfile_b /root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.summary.binary  -sortrowsbyphase 0  -includenotsignif 0 
