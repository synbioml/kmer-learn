echo "DNA, Drawing position histograms."
 perl /tmp/FIRE/SCRIPTS/draw_position_histogram.pl  --profiles=/root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.profiles --expfile=/root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt --outdir=/root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.histograms_OUT --targetfile=/root/omnigent/lab/kmer/kmer-learn/kmer/tests/data/enrichment_reference/clusters.txt_FIRE/DNA/clusters.txt.targets --rna=0 --seqlen=150 --bins=10 
